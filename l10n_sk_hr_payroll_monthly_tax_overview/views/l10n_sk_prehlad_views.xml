<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_sk_prehlad_list" model="ir.ui.view">
        <field name="name">l10n.sk.prehlad.list</field>
        <field name="model">l10n.sk.prehlad</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="year"/>
                <field name="month"/>
                <field name="lines_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_sk_prehlad_form" model="ir.ui.view">
        <field name="name">l10n.sk.prehlad.form</field>
        <field name="model">l10n.sk.prehlad</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object"
                            string="Generate"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" type="object"
                            string="Mark Submitted"
                            invisible="state != 'generated'"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="payment_date"/>
                            <field name="prepared_on" readonly="state != 'draft'"/>
                            <field name="request_bonus_refund"
                                   invisible="month not in ('3', '6', '9', '12')"/>
                        </group>
                        <group>
                            <field name="version_id"/>
                            <field name="correction_type"/>
                            <field name="correction_discovered_on"
                                   invisible="correction_type == 'regular'" readonly="state != 'draft'"/>
                            <field name="correction_reference"
                                   invisible="correction_type == 'regular'"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="xml_attachment_id"/>
                        </group>
                    </group>
                    <group string="Conditional form facts">
                        <group>
                            <field name="foreign_advance_source" readonly="state != 'draft'"/>
                            <field name="foreign_receipt_month" readonly="state != 'draft'"/>
                            <field name="foreign_advance_amount" readonly="state != 'draft'"/>
                            <field name="prior_advance_offset" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="form_inputs_evidence" readonly="state != 'draft'"/>
                            <button name="action_review_form_inputs" type="object"
                                    string="Review form facts" invisible="state != 'draft'"/>
                            <field name="form_inputs_reviewed_by"/>
                            <field name="form_inputs_reviewed_at"/>
                        </group>
                    </group>
                    <group string="Archived monthly facts" invisible="not submitted_attachment_id or filed_form_facts">
                        <field name="submitted_attachment_id" invisible="1"/>
                        <field name="filed_form_facts" invisible="1"/>
                        <field name="legacy_filed_foreign_source"/>
                        <field name="legacy_filed_premium_own"/>
                        <field name="legacy_filed_evidence"/>
                        <field name="legacy_filed_order"/>
                        <button name="action_review_legacy_filed_facts" type="object"
                                string="Review archived form facts"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="sequence"/>
                            <field name="employee_id"/>
                            <field name="vz_base"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_l10n_sk_prehlad" model="ir.actions.act_window">
        <field name="name">Monthly tax overview</field>
        <field name="res_model">l10n.sk.prehlad</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_sk_prehlad"
              name="SK monthly tax overview"
              parent="l10n_cssk_payroll_declaration_base.menu_cssk_payroll_declaration_root"
              action="action_l10n_sk_prehlad"
              sequence="30"/>

</odoo>
